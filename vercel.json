{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "feature/*": false,
      "develop": false,
      "release/*": false,
      "main": false
    }
  },
  "buildCommand": "npm run build:prod",
  "outputDirectory": "dist/aqua-track-web/browser",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
